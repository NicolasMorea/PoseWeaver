+namespace
+{
+    static uint16_t read_le_u16(const char* p)
+    {
+        uint16_t v;
+        std::memcpy(&v, p, sizeof(v));
+        return v;
+    }
+
+    static uint32_t read_le_u32(const char* p)
+    {
+        uint32_t v;
+        std::memcpy(&v, p, sizeof(v));
+        return v;
+    }
+
+    static uint64_t read_le_u64(const char* p)
+    {
+        uint64_t v;
+        std::memcpy(&v, p, sizeof(v));
+        return v;
+    }
+
+    // Parse Zip64 extended information extra field (0x0001) to recover
+    // 64-bit compressed/uncompressed sizes when local header stores 0xFFFFFFFF.
+    static bool parse_zip64_sizes(const std::vector<char>& extra, uint64_t& uncompressed, uint64_t& compressed)
+    {
+        size_t i = 0;
+        while (i + 4 <= extra.size())
+        {
+            const uint16_t header_id = read_le_u16(&extra[i]);
+            const uint16_t data_size = read_le_u16(&extra[i + 2]);
+            i += 4;
+            if (i + data_size > extra.size())
+                return false;
+
+            if (header_id == 0x0001)
+            {
+                // For local file headers, sizes appear as:
+                //   uncompressed size (8 bytes) then compressed size (8 bytes)
+                if (data_size < 16)
+                    return false;
+                uncompressed = read_le_u64(&extra[i]);
+                compressed = read_le_u64(&extra[i + 8]);
+                return true;
+            }
+            i += data_size;
+        }
+        return false;
+    }
+}
